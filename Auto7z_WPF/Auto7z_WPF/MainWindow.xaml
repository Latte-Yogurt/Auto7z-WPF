<Window x:Name="Auto7z" x:Class="Auto7z_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Auto7z_WPF"
        d:DataContext="{d:DesignInstance Type=local:Auto7zViewModel}"
        mc:Ignorable="d"
        Title="{DynamicResource Title}" 
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"      
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        AllowDrop="True" 
        Width="520" Height="260"
        KeyboardNavigation.TabNavigation="Cycle">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="{Binding ElementName=Auto7z, Path=ActualHeight}" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder" 
            Background="White" 
            BorderBrush="#33000000" 
            BorderThickness="2">

        <Grid x:Name="RootGrid" ClipToBounds="True" WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="MainGrid" Grid.Column="0" Margin="8">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0">
                    <TextBlock x:Name="Auto7zTitle" Text="{DynamicResource Title}" 
                               FontFamily="Microsoft YaHei Bold, DengXian Light" FontSize="13"
                               Style="{DynamicResource Black2BlueTextBlockStyle}" Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleModePanelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ToggleModePanelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0">
                    <Grid x:Name="MinimizeButton"
                          Background="Transparent"
                          Width="15" Height="15"
                          Cursor="Hand" >

                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding MinimizeCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Grid.InputBindings>

                        <Path Data="M0,8 L9,8" StrokeThickness="2" Style="{DynamicResource YellowGreenPathStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Width="10"/>
                    <!--Data的意思是:移动到(0,0)画线到(9,9)，再移动到(0,9)画线到(9,0)-->
                    <Grid x:Name="CloseButton"
                          Background="Transparent"
                          Width="15" Height="15"
                          Cursor="Hand">

                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Grid.InputBindings>

                        <Path Data="M0,0 L9,9 M0,9 L9,0" StrokeThickness="2" Style="{DynamicResource RedPathStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="ImagePanel" Style="{DynamicResource ImagePanelStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                    <Image x:Name="MainImage" Style="{DynamicResource MainWindowImageStyle}" Width="80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MainText" Style="{DynamicResource MainWindowTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="ModePanel" Style="{DynamicResource ModePanelStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
                    <RadioButton x:Name="RadioButton_Auto" TabIndex="0" Content="{DynamicResource AutoModeButton}" 
                                 Style="{StaticResource OperationMenuButtonStyle}"
                                 IsChecked="{Binding IsAutoModeSelected, Mode=OneWay}"
                                 Command="{Binding SelectOperationModeCommand}"
                                 CommandParameter="Auto"/>
                    <Grid Height="10"/>
                    <RadioButton x:Name="RadioButton_Zip" TabIndex="1" Content="{DynamicResource ZipModeButton}" 
                                 Style="{StaticResource OperationMenuButtonStyle}"
                                 IsChecked="{Binding IsZipModeSelected, Mode=OneWay}"
                                 Command="{Binding SelectOperationModeCommand}"
                                 CommandParameter="Zip"/>
                    <Grid Height="10"/>
                    <RadioButton x:Name="RadioButton_UnZip" TabIndex="2" Content="{DynamicResource UnZipModeButton}" 
                                 Style="{StaticResource OperationMenuButtonStyle}"
                                 IsChecked="{Binding IsUnZipModeSelected, Mode=OneWay}"
                                 Command="{Binding SelectOperationModeCommand}"
                                 CommandParameter="UnZip"/>
                </StackPanel>

                <Grid VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="60"/>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="AboutButton" TabIndex="3" Grid.Column="0" Content="{DynamicResource AboutButton}"
                            Height="24" MinWidth="90" Background="Transparent"
                            Command="{Binding AboutCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

                    <Button x:Name="SettingButton" TabIndex="4" Grid.Column="2" Style="{DynamicResource SettingBtnContentStyle}"
                            Height="24" MinWidth="90" Background="Transparent"
                            Click="SettingBtn_Click"/>
                </Grid>
            </Grid>

            <Border x:Name="SidePanel" Grid.Column="1" Background="#FDFDFD" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0">

                <Border.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Height" Value="24"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Height" Value="24"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Height" Value="24"/>
                        <Setter Property="Margin" Value="0,5"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Border.Resources>

                <Grid Margin="5">
                    <TabControl BorderThickness="0" Background="Transparent" FontFamily="Microsoft YaHei Light, DengXian Light, Microsoft YaHei">
                        <TabControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=TabControl}}" IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </TabControl.ItemsPanel>

                        <TabItem x:Name="TabGR_SidePanel" Header="{DynamicResource GeneralTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,5">

                                    <CheckBox x:Name="CheckBox_TopMost" TabIndex="10" Content="{DynamicResource TopmostCheckBox}" HorizontalAlignment="Left"/>
                                    <CheckBox x:Name="CheckBox_AutoSave" TabIndex="11" Content="{DynamicResource AutoSaveCheckBox}" HorizontalAlignment="Left"/>
                                    <CheckBox x:Name="CheckBox_Portable" TabIndex="12" Content="{DynamicResource PortableCheckBox}" HorizontalAlignment="Left"/>

                                    <StackPanel Orientation="Horizontal" Margin="3,5">
                                        <TextBlock Text="{DynamicResource RuntimeModeLabel}" Width="60"/>
                                        <ComboBox x:Name="ComboBox_RuntimeMode" TabIndex="13" Width="100">
                                            <ComboBoxItem Content="{DynamicResource RuntimeMode_Low}"/>
                                            <ComboBoxItem Content="{DynamicResource RuntimeMode_Balanced}"/>
                                            <ComboBoxItem Content="{DynamicResource RuntimeMode_High}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Margin="3,5">
                                        <TextBlock Text="{DynamicResource OutputPathLabel}"/>
                                        <Grid Height="10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="TextBox_FilePath" TabIndex="14" Grid.Column="0" Width="160" AllowDrop="True"/>
                                            <Button x:Name="BrowseButton" TabIndex="15" Grid.Column="2" Content="{DynamicResource BrowseButton}" Width="Auto" Background="Transparent" Click="BrowseOutputFolder_Click"/>
                                        </Grid>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="TabZP_SidePanel" Header="{DynamicResource ZipTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="5,5">

                                    <StackPanel Orientation="Horizontal" Margin="10,10">
                                        <TextBlock Text="{DynamicResource VolumeSizeLabel}" Width="60"/>
                                        <TextBox x:Name="TextBox_Volume" TabIndex="20" Width="100"/>
                                        <TextBlock Text="{DynamicResource MBUnit}" Margin="4,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="10,10" Style="{DynamicResource StackPanelAddon2Style}">
                                        <TextBlock Text="{DynamicResource GenerateMD5Label}" Width="60"/>
                                        <CheckBox x:Name="CheckBox_GenerateMD5" TabIndex="21" Content="{DynamicResource GenerateMD5Content}" Style="{DynamicResource EncFileNameCheckBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="10,10">
                                        <TextBlock Text="{DynamicResource ArchiveFormatLabel}" Width="60"/>
                                        <ComboBox x:Name="ComboBox_Format" TabIndex="22" Width="100">
                                            <ComboBoxItem Content="7z" IsSelected="True"/>
                                            <ComboBoxItem Content="zip"/>
                                            <ComboBoxItem Content="tar"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel x:Name="StackPanel_Addon" Orientation="Horizontal" Margin="10,10" Style="{DynamicResource StackPanelAddonStyle}">
                                        <TextBlock Text="{DynamicResource AddonOptionsLabel}" Width="60"/>
                                        <CheckBox x:Name="CheckBox_SolidMode" TabIndex="23" Content="{DynamicResource SolidModeContent}" Style="{DynamicResource SolidModeCheckBoxStyle}"/>
                                        <CheckBox x:Name="CheckBox_Zstd" TabIndex="24" Content="{DynamicResource ZstdContent}" Style="{DynamicResource ZstdCheckBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel x:Name="StackPanel_Addon2" Orientation="Horizontal" Margin="10,10" Style="{DynamicResource StackPanelAddon2Style}">
                                        <TextBlock Text="{DynamicResource AddonOptionsLabel}" Width="60"/>
                                        <CheckBox x:Name="CheckBox_ENCFileName" TabIndex="25" Content="{DynamicResource EncFileNameContent}" Style="{DynamicResource EncFileNameCheckBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="10,10">
                                        <TextBlock Text="{DynamicResource AddPasswordLabel}" Width="60"/>
                                        <TextBox x:Name="PasswordBox_Zip" TabIndex="26" Width="100" Text="{Binding PasswordBox_Zip_Text, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PasswordBoxZipStyle}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="10,10">
                                        <TextBlock Text="{DynamicResource CompressionLevelLabel}" Width="60"/>
                                        <ComboBox x:Name="ComboBox_ZipLevel" TabIndex="27" Width="100" Style="{DynamicResource ZipLevelComboBoxStyle}">
                                            <ComboBoxItem Content="{DynamicResource Level_Store}"/>
                                            <ComboBoxItem Content="{DynamicResource Level_Normal}"/>
                                            <ComboBoxItem Content="{DynamicResource Level_Ultra}"/>
                                        </ComboBox>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="TabUZ_SidePanel" Header="{DynamicResource UnZipTab}">
                            <ScrollViewer>
                                <StackPanel Margin="5,5">
                                    <StackPanel Orientation="Horizontal" Margin="10,10">
                                        <TextBlock Text="{DynamicResource UnzipPasswordLabel}" Width="60"/>
                                        <TextBox x:Name="PasswordBox_UnZip" TabIndex="30" Width="100"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>