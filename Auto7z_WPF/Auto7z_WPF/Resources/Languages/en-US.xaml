<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Title">Auto7z</sys:String>
    <sys:String x:Key="TitleText">Select Operation Mode</sys:String>
    <sys:String x:Key="AutoModeButton">Auto Mode</sys:String>
    <sys:String x:Key="ZipModeButton">Compress Mode</sys:String>
    <sys:String x:Key="UnZipModeButton">Decompress Mode</sys:String>
    <sys:String x:Key="MinimizeText">Minimize Auto7z</sys:String>
    <sys:String x:Key="CloseText">Close Auto7z</sys:String>
    <sys:String x:Key="AutoModeText">Drag &amp; Drop to Compress/Decompress</sys:String>
    <sys:String x:Key="ZipModeText">Drag &amp; Drop to Compress</sys:String>
    <sys:String x:Key="UnZipModeText">Drag &amp; Drop to Decompress</sys:String>
    <sys:String x:Key="AboutTitle">About Auto7z</sys:String>
    <sys:String x:Key="AboutText">About Auto7z</sys:String>
    <sys:String x:Key="SettingText">Configure Application Settings</sys:String>
    <sys:String x:Key="AboutButton">About</sys:String>
    <sys:String x:Key="SettingButton">Setting &gt;&gt;</sys:String>
    <sys:String x:Key="HideSettingButton">&lt;&lt; Hide</sys:String>
    <sys:String x:Key="GeneralTab">General</sys:String>
    <sys:String x:Key="TopmostCheckBox">Always on Top</sys:String>
    <sys:String x:Key="AutoSaveCheckBox">Save config on Exit</sys:String>
    <sys:String x:Key="Log_PortableSwitched">Switched to {0}, data folder: {1}</sys:String>
    <sys:String x:Key="Err_PortableMoveFailed">Failed to switch to {0}: the data folder could not be moved</sys:String>
    <sys:String x:Key="Tip_Portable">Portable mode: keeps the config, components and logs in .config\Auto7z next to the program, so it can be carried around. Unchecking moves them back to %LOCALAPPDATA%\Auto7z.</sys:String>
    <sys:String x:Key="PortableCheckBox">Portable</sys:String>
    <sys:String x:Key="ZipTab">Zip</sys:String>
    <sys:String x:Key="UnZipTab">UnZip</sys:String>
    <sys:String x:Key="RuntimeModeLabel">Mode:</sys:String>
    <sys:String x:Key="RuntimeMode_Low">Low</sys:String>
    <sys:String x:Key="RuntimeMode_Balanced">Balanced</sys:String>
    <sys:String x:Key="RuntimeMode_High">High</sys:String>
    <sys:String x:Key="OutputPathLabel">Output:</sys:String>
    <sys:String x:Key="BrowseButton">...</sys:String>
    <sys:String x:Key="VolumeSizeLabel">Split:</sys:String>
    <sys:String x:Key="MBUnit">MB</sys:String>
    <sys:String x:Key="ArchiveFormatLabel">Format:</sys:String>
    <sys:String x:Key="AddonOptionsLabel">Options:</sys:String>
    <sys:String x:Key="SolidModeContent">Solid</sys:String>
    <sys:String x:Key="ZstdContent">zstd</sys:String>
    <sys:String x:Key="EncFileNameContent">Encrypt names</sys:String>
    <sys:String x:Key="GenerateMD5Label">MD5:</sys:String>
    <sys:String x:Key="GenerateMD5Content">MD5 file</sys:String>
    <sys:String x:Key="AddPasswordLabel">Password:</sys:String>
    <sys:String x:Key="CompressionLevelLabel">Level:</sys:String>
    <sys:String x:Key="Level_Store">Store</sys:String>
    <sys:String x:Key="Level_Normal">Normal</sys:String>
    <sys:String x:Key="Level_Ultra">Ultra</sys:String>
    <sys:String x:Key="UnzipPasswordLabel">Password:</sys:String>
    <sys:String x:Key="GithubText">GitHub Page</sys:String>
    <sys:String x:Key="LicenseText">License</sys:String>
    <sys:String x:Key="ConfirmButton">Confirm</sys:String>
<sys:String x:Key="PasswordWrongAttempt">Wrong password, attempt {0}. Please enter it again:</sys:String>
    <sys:String x:Key="OkButton">OK</sys:String>
    <sys:String x:Key="NoButton">No</sys:String>
    <sys:String x:Key="YesButton">Yes</sys:String>
    <sys:String x:Key="CopyRightText">All rights reserved.</sys:String>
    <!-- Password window -->
    <sys:String x:Key="PasswordWindowTitle">Enter password</sys:String>
    <sys:String x:Key="PasswordPromptText">Encrypted. Enter password:</sys:String>
    <sys:String x:Key="CancelTaskButton">Cancel</sys:String>
    <!-- Setting tooltips -->
    <sys:String x:Key="Tip_TopMost">Keep the window above all other windows.</sys:String>
    <sys:String x:Key="Tip_AutoSave">Save all settings automatically when the app closes. Uncheck to keep the previous config.</sys:String>
    <sys:String x:Key="Tip_RuntimeMode">Controls resource usage while compressing: thread count and dictionary size. Low uses least memory, High is fastest.</sys:String>
    <sys:String x:Key="Tip_OutputPath">Output directory for archives. Type it, or drop a folder (used as-is) or a file (its parent folder is used). Leave empty to output next to the source file.</sys:String>
    <sys:String x:Key="Tip_Volume">Split size in MB. Enter 0 to disable splitting. No split happens when the data is smaller than this value.</sys:String>
    <sys:String x:Key="Tip_Volume_Invalid">Invalid input: enter an integer greater than or equal to 0 (in MB), where 0 means no splitting.</sys:String>
    <sys:String x:Key="Tip_Format">Archive format. 7z supports encryption and solid mode; zip is the most compatible; tar only stores without compressing.</sys:String>
    <sys:String x:Key="Tip_SolidMode">Solid compression merges files into one block for better ratio, but the whole block must be extracted. Recommended with multiple files.</sys:String>
    <sys:String x:Key="Tip_Zstd">Compress the tar package with zstd to produce a .tar.zst, which is significantly smaller.</sys:String>
    <sys:String x:Key="Tip_EncFileName">Encrypt file names as well. Requires a password first. Only supported by 7z.</sys:String>
    <sys:String x:Key="Tip_GenerateMD5">Generate a .md5 checksum file next to the archive to verify its integrity.</sys:String>
    <sys:String x:Key="Tip_CompressionLevel">Compression level. Store = no compression (fastest); Normal = balanced; Ultra = smallest but slowest. Effective for 7z and zip; tar does not compress.</sys:String>
    <sys:String x:Key="Tip_ZipPassword">Password for compression. Leave empty for no encryption. The tar format does not support encryption.</sys:String>
    <sys:String x:Key="Tip_UnzipPassword">Password for extraction. Leave empty if the archive is not encrypted. tar archives need no password.</sys:String>
    <sys:String x:Key="Tip_CloseButton">Close the program.</sys:String>
    <sys:String x:Key="Tip_CloseButtonCancel">Close the program. While a task is running: right-click here to cancel it.</sys:String>

    <sys:String x:Key="InfoTitle">Info</sys:String>
    <sys:String x:Key="WarningTitle">Warning</sys:String>
    <sys:String x:Key="ErrorTitle">Error</sys:String>

    <sys:String x:Key="InfoMessage">Info: </sys:String>
    <sys:String x:Key="WarningMessage">Warning: </sys:String>
    <sys:String x:Key="ProgressText">7z: {0}%</sys:String>
    <sys:String x:Key="Md5ProgressText">MD5: {0}%</sys:String>
    <sys:String x:Key="ErrorMessage">An error occurred: </sys:String>
    <sys:String x:Key="MultiFilePackQuery">Multiple files have been detected. Do you want to package them into a single compressed file?</sys:String>
    <!-- Task result messages -->
    <sys:String x:Key="Result_CompressDone">Compression done</sys:String>
    <sys:String x:Key="Result_ExtractDone">Extraction done</sys:String>
    <sys:String x:Key="Result_Failed">Failed</sys:String>
    <sys:String x:Key="Result_Cancelled">Task cancelled</sys:String>
    <sys:String x:Key="Result_PartialWarning">Compression finished, but some files were skipped. See the log for details.</sys:String>
    <sys:String x:Key="Err_UnexpectedExitCode">7-Zip returned a non-zero exit code: {0}</sys:String>
    <sys:String x:Key="Err_ProcessNotExited">The 7-Zip process did not exit after cancellation</sys:String>
    <sys:String x:Key="Archive_MergedNamePattern">{0} and {1} more</sys:String>
    <sys:String x:Key="Log_InstallDirNotWritable">The install directory is not writable (does not affect running; components and config go to %LOCALAPPDATA%\Auto7z): {0}</sys:String>
    <sys:String x:Key="Log_PathsNotFound">None of the given paths exist or are accessible: {0}</sys:String>
    <sys:String x:Key="Log_ShellRegisterFailed">Failed to update the context menu registration: {0}</sys:String>
    <sys:String x:Key="Log_BusyIgnore">A task is already running, ignoring the {0} incoming item(s)</sys:String>
    <sys:String x:Key="Log_ReceivedItems">Received {0} item(s): {1}</sys:String>
    <sys:String x:Key="Log_UnknownFormat">Unrecognized archive format in the config, using 7z: {0}</sys:String>
    <sys:String x:Key="Log_DialogConfirmed">Prompt: the user chose Yes</sys:String>
    <sys:String x:Key="Log_DialogCancelled">Prompt: the user chose No</sys:String>
    <sys:String x:Key="Log_Md5Failed">Failed to generate the MD5 file: {0}</sys:String>
    <!-- Error messages -->
    <sys:String x:Key="Err_NoCompressInput">Nothing to compress</sys:String>
    <sys:String x:Key="Err_UnknownOutputDir">Cannot determine the output directory</sys:String>
    <sys:String x:Key="Err_OutputDirNotFound">Output directory does not exist: {0}</sys:String>
    <sys:String x:Key="Err_OutputDirNotWritable">Output directory is not writable: {0}</sys:String>
    <sys:String x:Key="Err_ArchiveNotFound">Archive file does not exist</sys:String>
    <sys:String x:Key="Err_UnknownExtractDir">Cannot determine the extraction directory</sys:String>
    <sys:String x:Key="Err_ExtractDirNotWritable">Archive directory is not writable: {0}</sys:String>
    <sys:String x:Key="Err_BuildCompressCommand">Cannot build the compression command</sys:String>
    <sys:String x:Key="Err_ArchiveNotCreated">The command finished but no archive was created: {0}</sys:String>
    <sys:String x:Key="Err_BuildExtractCommand">Cannot build the extraction command</sys:String>
    <sys:String x:Key="Err_PasswordRetries">Too many wrong passwords, extraction aborted</sys:String>
    <sys:String x:Key="Err_InnerTarFailed">Failed to extract the inner tar</sys:String>
    <sys:String x:Key="Err_ComponentMissing">7-Zip components not found</sys:String>
    <sys:String x:Key="Err_ResourceMissing">Resource not found: {0}</sys:String>
    <sys:String x:Key="Err_EmptyCommand">The command is empty</sys:String>
    <sys:String x:Key="Err_SevenZipExeMissing">7z.exe not found: {0}</sys:String>

    <!-- Internal log texts -->
    <sys:String x:Key="Log_LanguageSwitchFailed">Failed to switch language ({0}): {1}</sys:String>
    <sys:String x:Key="Log_AutoExtractEach">Auto mode: extracting {0} archive(s) one by one</sys:String>
    <sys:String x:Key="Log_TaskException">Task failed: {0}</sys:String>
    <sys:String x:Key="Log_ChoseMerge">The user chose to merge, {0} file(s) into one archive</sys:String>
    <sys:String x:Key="Log_ChoseSeparate">The user chose not to merge, {0} file(s) compressed separately</sys:String>
    <sys:String x:Key="Log_SevenZipWarning">7-Zip reported a warning but finished: {0}</sys:String>
    <sys:String x:Key="Log_PasswordDialogFailed">Failed to show the password prompt: {0}</sys:String>
    <sys:String x:Key="Log_PasswordCancelled">The user cancelled the password prompt</sys:String>
    <sys:String x:Key="Log_PasswordAsked">7-Zip asked for a password, attempt {0}</sys:String>
    <sys:String x:Key="Log_PasswordWrong">Wrong password, attempt {0}. Please try again.</sys:String>
    <sys:String x:Key="Log_PasswordGot">Password obtained</sys:String>
    <sys:String x:Key="Log_InnerTarMissing">Intermediate tar file not found: {0}</sys:String>
    <sys:String x:Key="Log_InnerTarFailed">Failed to extract the inner tar: {0}</sys:String>
    <sys:String x:Key="Log_OutputPathInvalid">The output path does not exist and was cleared: {0}</sys:String>
    <sys:String x:Key="Log_TaskCancelled">Task cancelled</sys:String>
    <sys:String x:Key="ProcessWindowTitle">Processing</sys:String>
