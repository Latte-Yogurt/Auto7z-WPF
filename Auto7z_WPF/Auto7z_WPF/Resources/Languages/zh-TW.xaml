    <sys:String x:Key="Log_PasswordAsked">7-Zip 索要密碼，第 {0} 次嘗試，彈窗請求輸入</sys:String>
    <sys:String x:Key="Log_PasswordWrong">密碼錯誤，第 {0} 次嘗試，重新詢問密碼</sys:String>
    <sys:String x:Key="Log_PasswordGot">已取得密碼</sys:String>
    <sys:String x:Key="Log_InnerTarMissing">找不到中間 tar 檔案：{0}</sys:String>
    <sys:String x:Key="Log_InnerTarFailed">解開中間 tar 失敗：{0}</sys:String>
    <sys:String x:Key="Log_OutputPathInvalid">輸出路徑不存在，已清空：{0}</sys:String>
    <sys:String x:Key="Log_TaskCancelled">工作已取消</sys:String>
</ResourceDictionary>
