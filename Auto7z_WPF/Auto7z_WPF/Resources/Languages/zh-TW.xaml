<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Title">Auto7z</sys:String>
    <sys:String x:Key="TitleText">選擇運行模式</sys:String>
    <sys:String x:Key="AutoModeButton">自動模式</sys:String>
    <sys:String x:Key="ZipModeButton">壓縮模式</sys:String>
    <sys:String x:Key="UnZipModeButton">解壓縮模式</sys:String>
    <sys:String x:Key="MinimizeText">最小化Auto7z</sys:String>
    <sys:String x:Key="CloseText">關閉Auto7z</sys:String>
    <sys:String x:Key="AutoModeText">拖曳檔案以自動壓縮/解壓縮</sys:String>
    <sys:String x:Key="ZipModeText">拖曳檔案以自動壓縮</sys:String>
    <sys:String x:Key="UnZipModeText">拖曳檔案以自動解壓縮</sys:String>
    <sys:String x:Key="AboutTitle">關於 Auto7z</sys:String>
    <sys:String x:Key="AboutText">關於 Auto7z</sys:String>
    <sys:String x:Key="SettingText">進行應用程式設定</sys:String>
    <sys:String x:Key="AboutButton">關於</sys:String>
    <sys:String x:Key="SettingButton">設定 &gt;&gt;</sys:String>
    <sys:String x:Key="HideSettingButton">&lt;&lt; 隱藏</sys:String>
    <sys:String x:Key="GeneralTab">基本設定</sys:String>
    <sys:String x:Key="TopmostCheckBox">視窗置頂</sys:String>
    <sys:String x:Key="AutoSaveCheckBox">關閉程式時自動儲存設定</sys:String>
    <sys:String x:Key="Log_PortableSwitched">已切換到{0}，資料目錄：{1}</sys:String>
    <sys:String x:Key="Err_PortableMoveFailed">切換{0}失敗：資料目錄沒能移動</sys:String>
    <sys:String x:Key="Tip_Portable">便攜模式：把設定、元件與日誌都放在程式目錄的 .config\Auto7z 下，整個程式可以隨身攜帶。取消勾選則移回 %LOCALAPPDATA%\Auto7z。</sys:String>
    <sys:String x:Key="PortableCheckBox">便攜模式</sys:String>
    <sys:String x:Key="ZipTab">壓縮</sys:String>
    <sys:String x:Key="UnZipTab">解壓縮</sys:String>
    <sys:String x:Key="RuntimeModeLabel">執行模式:</sys:String>
    <sys:String x:Key="RuntimeMode_Low">低佔用</sys:String>
    <sys:String x:Key="RuntimeMode_Balanced">均衡</sys:String>
    <sys:String x:Key="RuntimeMode_High">高效能</sys:String>
    <sys:String x:Key="OutputPathLabel">輸出路徑:</sys:String>
    <sys:String x:Key="BrowseButton">...</sys:String>
    <sys:String x:Key="VolumeSizeLabel">分卷大小:</sys:String>
    <sys:String x:Key="MBUnit">MB</sys:String>
    <sys:String x:Key="ArchiveFormatLabel">生成格式:</sys:String>
    <sys:String x:Key="AddonOptionsLabel">附加選項:</sys:String>
    <sys:String x:Key="SolidModeContent">固實壓縮</sys:String>
    <sys:String x:Key="ZstdContent">zstd</sys:String>
    <sys:String x:Key="EncFileNameContent">完全加密</sys:String>
    <sys:String x:Key="GenerateMD5Label">MD5:</sys:String>
    <sys:String x:Key="GenerateMD5Content">產生校驗檔</sys:String>
    <sys:String x:Key="AddPasswordLabel">添加密碼:</sys:String>
    <sys:String x:Key="CompressionLevelLabel">壓縮等級:</sys:String>
    <sys:String x:Key="Level_Store">存儲</sys:String>
    <sys:String x:Key="Level_Normal">標準</sys:String>
    <sys:String x:Key="Level_Ultra">極限</sys:String>
    <sys:String x:Key="UnzipPasswordLabel">解壓密碼:</sys:String>
    <sys:String x:Key="GithubText">GitHub主頁</sys:String>
    <sys:String x:Key="LicenseText">許可證</sys:String>
    <sys:String x:Key="ConfirmButton">確定</sys:String>
    <sys:String x:Key="PasswordWrongAttempt">密碼錯誤，第 {0} 次嘗試，重新詢問密碼</sys:String>
    <sys:String x:Key="OkButton">確定</sys:String>
    <sys:String x:Key="NoButton">否</sys:String>
    <sys:String x:Key="YesButton">是</sys:String>
    <sys:String x:Key="CopyRightText">All rights reserved.</sys:String>
    <!-- 密碼輸入視窗 -->
    <sys:String x:Key="PasswordWindowTitle">輸入密碼</sys:String>
    <sys:String x:Key="PasswordPromptText">該壓縮檔已加密，請輸入密碼：</sys:String>
    <sys:String x:Key="CancelTaskButton">取消</sys:String>
    <!-- 設定項懸停提示 -->
    <sys:String x:Key="Tip_TopMost">讓視窗永遠顯示在其他視窗之上。</sys:String>
    <sys:String x:Key="Tip_AutoSave">程式關閉時自動儲存目前所有設定。取消勾選則保留上次的設定。</sys:String>
    <sys:String x:Key="Tip_RuntimeMode">控制壓縮時的資源占用：執行緒數量與字典大小。低佔用最省記憶體，高效能最快。</sys:String>
    <sys:String x:Key="Tip_OutputPath">壓縮檔的輸出目錄。可直接輸入，也可拖入資料夾（取該資料夾）或拖入檔案（取其上一層目錄）。留空則輸出到來源檔案所在目錄。</sys:String>
    <sys:String x:Key="Tip_Volume">分卷大小（MB）。填 0 表示不分卷。資料量小於該值時也不會分卷。</sys:String>
    <sys:String x:Key="Tip_Volume_Invalid">輸入無效：請填寫大於等於 0 的整數（單位 MB），0 表示不分卷。</sys:String>
    <sys:String x:Key="Tip_Format">生成格式。7z 支援加密與固實；zip 相容性最好；tar 僅封裝不壓縮。</sys:String>
    <sys:String x:Key="Tip_SolidMode">固實壓縮：把多個檔案合併成一個資料區塊壓縮，壓縮率更高，但解壓時需整塊解出。多檔案時建議開啟。</sys:String>
    <sys:String x:Key="Tip_Zstd">對 tar 封裝再使用 zstd 壓縮，產生 .tar.zst，可顯著減小體積。</sys:String>
    <sys:String x:Key="Tip_EncFileName">完全加密：連檔名也一起加密。需要先設定密碼，僅 7z 格式支援。</sys:String>
    <sys:String x:Key="Tip_GenerateMD5">壓縮完成後在同目錄產生 .md5 校驗檔，可用於校驗檔案完整性。</sys:String>
    <sys:String x:Key="Tip_CompressionLevel">壓縮等級。存儲=不壓縮（最快）；標準=均衡；極限=體積最小但最慢。7z 與 zip 有效，tar 本身不壓縮故無效。</sys:String>
    <sys:String x:Key="Tip_ZipPassword">壓縮密碼。留空表示不加密。tar 格式不支援加密。</sys:String>
    <sys:String x:Key="Tip_UnzipPassword">解壓密碼。留空表示不解密。tar 格式不需要密碼。</sys:String>
    <sys:String x:Key="Tip_CloseButton">關閉程式。</sys:String>
    <sys:String x:Key="Tip_CloseButtonCancel">關閉程式。工作執行中：右鍵此處可終止目前的工作。</sys:String>

    <sys:String x:Key="InfoTitle">提示</sys:String>
    <sys:String x:Key="WarningTitle">警告</sys:String>
    <sys:String x:Key="ErrorTitle">錯誤</sys:String>

    <sys:String x:Key="InfoMessage">提示：</sys:String>
    <sys:String x:Key="WarningMessage">警告：</sys:String>
    <sys:String x:Key="ProgressText">7z 處理：已進行...{0}%</sys:String>
    <sys:String x:Key="Md5ProgressText">MD5 計算進度...{0}%</sys:String>
    <sys:String x:Key="ErrorMessage">出現錯誤：</sys:String>
    <sys:String x:Key="MultiFilePackQuery">檢測到多個檔案傳入，是否需要將其打包為單個壓縮檔？</sys:String>
    <!-- 任務結果提示 -->
    <sys:String x:Key="Result_CompressDone">壓縮完成</sys:String>
    <sys:String x:Key="Result_ExtractDone">解壓完成</sys:String>
    <sys:String x:Key="Result_Failed">處理失敗</sys:String>
    <sys:String x:Key="Result_Cancelled">工作已取消</sys:String>
    <sys:String x:Key="Result_PartialWarning">壓縮已完成，但部分檔案被跳過，詳情見日誌。</sys:String>
    <sys:String x:Key="Err_UnexpectedExitCode">7-Zip 回傳非 0 結束碼：{0}</sys:String>
    <sys:String x:Key="Err_ProcessNotExited">7-Zip 程序在取消後未能結束</sys:String>
    <sys:String x:Key="Archive_MergedNamePattern">{0} 等 {1} 個</sys:String>
    <sys:String x:Key="Log_InstallDirNotWritable">程式所在目錄不可寫（不影響執行，元件與設定均寫入 %LOCALAPPDATA%\Auto7z）：{0}</sys:String>
    <sys:String x:Key="Log_PathsNotFound">傳入的路徑均不存在或無法存取：{0}</sys:String>
    <sys:String x:Key="Log_ShellRegisterFailed">右鍵選單註冊處理失敗：{0}</sys:String>
    <sys:String x:Key="Log_BusyIgnore">已有工作在執行，忽略本次傳入的 {0} 個項目</sys:String>
    <sys:String x:Key="Log_ReceivedItems">接收 {0} 個項目：{1}</sys:String>
    <sys:String x:Key="Log_UnknownFormat">設定中的壓縮格式無法辨識，已按 7z 處理：{0}</sys:String>
    <sys:String x:Key="Log_DialogConfirmed">詢問框：使用者選擇「是」</sys:String>
    <sys:String x:Key="Log_DialogCancelled">詢問框：使用者選擇「否」</sys:String>
    <sys:String x:Key="Log_Md5Failed">產生 MD5 失敗：{0}</sys:String>
    <!-- 錯誤訊息 -->
    <sys:String x:Key="Err_NoCompressInput">沒有可壓縮的輸入</sys:String>
    <sys:String x:Key="Err_UnknownOutputDir">無法確定輸出目錄</sys:String>
    <sys:String x:Key="Err_OutputDirNotFound">輸出目錄不存在：{0}</sys:String>
    <sys:String x:Key="Err_OutputDirNotWritable">輸出目錄不可寫：{0}</sys:String>
    <sys:String x:Key="Err_ArchiveNotFound">壓縮檔不存在</sys:String>
    <sys:String x:Key="Err_UnknownExtractDir">無法確定解壓目錄</sys:String>
    <sys:String x:Key="Err_ExtractDirNotWritable">壓縮檔所在目錄不可寫：{0}</sys:String>
    <sys:String x:Key="Err_BuildCompressCommand">無法建構壓縮命令</sys:String>
    <sys:String x:Key="Err_ArchiveNotCreated">壓縮命令已結束，但未產生壓縮檔：{0}</sys:String>
    <sys:String x:Key="Err_BuildExtractCommand">無法建構解壓命令</sys:String>
    <sys:String x:Key="Err_PasswordRetries">連續多次密碼錯誤，已放棄解壓</sys:String>
    <sys:String x:Key="Err_InnerTarFailed">解壓壓縮 tar 失敗：未能解開內部的 tar</sys:String>
    <sys:String x:Key="Err_ComponentMissing">找不到 7-Zip 元件</sys:String>
    <sys:String x:Key="Err_ResourceMissing">找不到資源：{0}</sys:String>
    <sys:String x:Key="Err_EmptyCommand">命令行為空</sys:String>
    <sys:String x:Key="Err_SevenZipExeMissing">找不到 7z.exe：{0}</sys:String>

    <!-- 內部日誌文字 -->
    <sys:String x:Key="Log_LanguageSwitchFailed">切換語言失敗（{0}）：{1}</sys:String>
    <sys:String x:Key="Log_AutoExtractEach">自動模式：逐個解壓 {0} 個壓縮檔</sys:String>
    <sys:String x:Key="Log_TaskException">工作執行異常：{0}</sys:String>
    <sys:String x:Key="Log_ChoseMerge">使用者選擇合併為單個壓縮檔，共 {0} 個檔案</sys:String>
