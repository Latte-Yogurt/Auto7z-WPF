<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 主窗体部分 -->
    <sys:String x:Key="Title">Auto7z</sys:String>
    <sys:String x:Key="TitleText" xml:space="preserve">选择运行模式</sys:String>
    <sys:String x:Key="AutoModeButton">自动模式</sys:String>
    <sys:String x:Key="ZipModeButton">压缩模式</sys:String>
    <sys:String x:Key="UnZipModeButton">解压模式</sys:String>
    <sys:String x:Key="MinimizeText">最小化Auto7z</sys:String>
    <sys:String x:Key="CloseText">关闭Auto7z</sys:String>
    <sys:String x:Key="AutoModeText">拖拽文件以自动压缩/解压</sys:String>
    <sys:String x:Key="ZipModeText">拖拽文件以自动压缩</sys:String>
    <sys:String x:Key="UnZipModeText">拖拽文件以自动解压</sys:String>
    <sys:String x:Key="AboutButton">关于</sys:String>
    <sys:String x:Key="AboutText">关于Auto7z</sys:String>
    <sys:String x:Key="SettingButton">设置 &gt;&gt;</sys:String>
    <sys:String x:Key="HideSettingButton">&lt;&lt; 隐藏</sys:String>
    <sys:String x:Key="SettingText">设置应用参数</sys:String>
    <!-- 关于文本部分 -->
    <sys:String x:Key="AboutTitle">关于 Auto7z</sys:String>
    <sys:String x:Key="GithubText">GitHub主页</sys:String>
    <sys:String x:Key="LicenseText">许可证</sys:String>
    <sys:String x:Key="ConfirmButton">确定</sys:String>
    <sys:String x:Key="PasswordWrongAttempt">密码错误，第 {0} 次尝试，重新询问密码</sys:String>
    <sys:String x:Key="OkButton">确定</sys:String>
    <sys:String x:Key="NoButton">否</sys:String>
    <sys:String x:Key="YesButton">是</sys:String>
    <sys:String x:Key="CopyRightText">All rights reserved.</sys:String>
    <!-- 密码输入窗口 -->
    <sys:String x:Key="PasswordWindowTitle">输入密码</sys:String>
    <sys:String x:Key="PasswordPromptText">该压缩包已加密，请输入密码：</sys:String>
    <sys:String x:Key="CancelTaskButton">取消</sys:String>
    <!-- 设置项悬停提示 -->
    <sys:String x:Key="Tip_TopMost">让窗口始终显示在所有其他窗口之上。</sys:String>
    <sys:String x:Key="Tip_AutoSave">程序关闭时自动保存当前所有设置。取消勾选则保留上次的配置。</sys:String>
    <sys:String x:Key="Tip_RuntimeMode">控制压缩时的资源占用：线程数与字典大小。低占用最省内存，高性能最快。</sys:String>
    <sys:String x:Key="Tip_OutputPath">压缩包的输出目录。可直接输入，也可拖入文件夹（取该文件夹）或拖入文件（取其上一级目录）。留空则输出到源文件所在目录。</sys:String>
    <sys:String x:Key="Tip_Volume">分卷大小（MB）。填 0 表示不分卷。数据量小于该值时也不会分卷。</sys:String>
    <sys:String x:Key="Tip_Volume_Invalid">输入无效：请填写大于等于 0 的整数（单位 MB），0 表示不分卷。</sys:String>
    <sys:String x:Key="Tip_Format">生成格式。7z 支持加密与固实；zip 通用性最好；tar 仅打包不压缩。</sys:String>
    <sys:String x:Key="Tip_SolidMode">固实压缩：把多个文件合并成一个数据块压缩，压缩率更高，但解压时需整块解出。多文件时推荐开启。</sys:String>
    <sys:String x:Key="Tip_Zstd">对 tar 包再使用 zstd 压缩，生成 .tar.zst，可显著减小体积。</sys:String>
    <sys:String x:Key="Tip_EncFileName">完全加密：连文件名也一起加密。需要先设置密码，仅 7z 格式支持。</sys:String>
    <sys:String x:Key="Tip_GenerateMD5">压缩完成后在同目录生成 .md5 校验文件，可用于校验文件完整性。</sys:String>
    <sys:String x:Key="Tip_CompressionLevel">压缩等级。存储=不压缩（最快）；标准=均衡；极限=体积最小但最慢。7z 与 zip 有效，tar 本身不压缩故无效。</sys:String>
    <sys:String x:Key="Tip_ZipPassword">压缩密码。留空表示不加密。tar 格式不支持加密。</sys:String>
    <sys:String x:Key="Tip_UnzipPassword">解压密码。留空表示不解密。tar 格式不需要密码。</sys:String>
    <sys:String x:Key="Tip_CloseButton">关闭程序。</sys:String>
    <sys:String x:Key="Tip_CloseButtonCancel">关闭程序。任务运行中：右键此处可终止当前任务。</sys:String>
    <!-- 侧面板部分 -->
    <!-- 基础设置部分 -->
    <sys:String x:Key="GeneralTab">基础设置</sys:String>
    <sys:String x:Key="TopmostCheckBox">窗口置顶</sys:String>
    <sys:String x:Key="AutoSaveCheckBox">程序关闭时自动保存设置</sys:String>
    <sys:String x:Key="Log_PortableSwitched">已切换到{0}，数据目录：{1}</sys:String>
    <sys:String x:Key="Err_PortableMoveFailed">切换{0}失败：数据目录没能移动</sys:String>
    <sys:String x:Key="Tip_Portable">便携模式：把配置、组件与日志都放在程序目录的 .config\Auto7z 下，整个程序可以随身携带。取消勾选则移回 %LOCALAPPDATA%\Auto7z。</sys:String>
    <sys:String x:Key="PortableCheckBox">便携模式</sys:String>
    <!-- 压缩设置部分 -->
    <sys:String x:Key="ZipTab">压缩</sys:String>
    <!-- 解压设置部分 -->
    <sys:String x:Key="UnZipTab">解压</sys:String>
    <!-- 运行模式 -->
    <sys:String x:Key="RuntimeModeLabel">运行模式:</sys:String>
    <sys:String x:Key="RuntimeMode_Low">低占用</sys:String>
    <sys:String x:Key="RuntimeMode_Balanced">均衡</sys:String>
    <sys:String x:Key="RuntimeMode_High">高性能</sys:String>
    <!-- 输出路径 -->
    <sys:String x:Key="OutputPathLabel">输出路径:</sys:String>
    <sys:String x:Key="BrowseButton">...</sys:String>
    <!-- 压缩面板 -->
    <sys:String x:Key="VolumeSizeLabel">分卷大小:</sys:String>
    <sys:String x:Key="MBUnit">MB</sys:String>
    <sys:String x:Key="ArchiveFormatLabel">生成格式:</sys:String>
    <sys:String x:Key="AddonOptionsLabel">附加选项:</sys:String>
    <sys:String x:Key="SolidModeContent">固实压缩</sys:String>
    <sys:String x:Key="ZstdContent">zstd</sys:String>
    <sys:String x:Key="EncFileNameContent">完全加密</sys:String>
    <sys:String x:Key="GenerateMD5Label">MD5:</sys:String>
    <sys:String x:Key="GenerateMD5Content">生成校验文件</sys:String>
    <sys:String x:Key="AddPasswordLabel">添加密码:</sys:String>
    <sys:String x:Key="CompressionLevelLabel">压缩等级:</sys:String>
    <sys:String x:Key="Level_Store">存储</sys:String>
    <sys:String x:Key="Level_Normal">标准</sys:String>
    <sys:String x:Key="Level_Ultra">极限</sys:String>
    <sys:String x:Key="UnzipPasswordLabel">解压密码:</sys:String>
    <!-- 消息部分 -->
    <!-- 消息主题部分 -->
    <sys:String x:Key="InfoTitle">提示</sys:String>
    <sys:String x:Key="WarningTitle">警告</sys:String>
    <sys:String x:Key="ErrorTitle">错误</sys:String>
    <!-- 消息文本部分 -->
    <sys:String x:Key="InfoMessage">提示：</sys:String>
    <sys:String x:Key="WarningMessage">警告：</sys:String>
    <sys:String x:Key="ErrorMessage">错误：</sys:String>
    <sys:String x:Key="ProgressText">7z 处理：已进行...{0}%</sys:String>
    <sys:String x:Key="Md5ProgressText">MD5 计算进度...{0}%</sys:String>
    <sys:String x:Key="MultiFilePackQuery">检测到多个文件传入，是否需要将多个文件打包为单个压缩文件中？</sys:String>
    <!-- 任务结果提示 -->
    <sys:String x:Key="Result_CompressDone">压缩完成</sys:String>
    <sys:String x:Key="Result_ExtractDone">解压完成</sys:String>
    <sys:String x:Key="Result_Failed">处理失败</sys:String>
    <sys:String x:Key="Result_Cancelled">任务已取消</sys:String>
    <sys:String x:Key="Result_PartialWarning">压缩已完成，但部分文件被跳过，详情见日志。</sys:String>
    <sys:String x:Key="Err_UnexpectedExitCode">7-Zip 返回非 0 退出码：{0}</sys:String>
    <sys:String x:Key="Err_ProcessNotExited">7-Zip 进程未能在取消后退出</sys:String>
    <sys:String x:Key="Archive_MergedNamePattern">{0} 等 {1} 个</sys:String>
    <sys:String x:Key="Log_InstallDirNotWritable">程序所在目录不可写（不影响运行，组件与配置均写入 %LOCALAPPDATA%\Auto7z）：{0}</sys:String>
    <sys:String x:Key="Log_PathsNotFound">传入的路径均不存在或不可访问：{0}</sys:String>
    <sys:String x:Key="Log_ShellRegisterFailed">右键菜单注册处理失败：{0}</sys:String>
    <sys:String x:Key="Log_BusyIgnore">已有任务正在执行，忽略本次传入的 {0} 个项目</sys:String>
    <sys:String x:Key="Log_ReceivedItems">接收 {0} 个项目：{1}</sys:String>
    <sys:String x:Key="Log_UnknownFormat">配置中的压缩格式无法识别，已按 7z 处理：{0}</sys:String>
    <sys:String x:Key="Log_DialogConfirmed">询问框：用户选择“是”</sys:String>
    <sys:String x:Key="Log_DialogCancelled">询问框：用户选择“否”</sys:String>
    <sys:String x:Key="Log_Md5Failed">生成 MD5 失败：{0}</sys:String>
    <!-- 错误消息 -->
    <sys:String x:Key="Err_NoCompressInput">没有可压缩的输入</sys:String>
    <sys:String x:Key="Err_UnknownOutputDir">无法确定输出目录</sys:String>
    <sys:String x:Key="Err_OutputDirNotFound">输出目录不存在：{0}</sys:String>
    <sys:String x:Key="Err_OutputDirNotWritable">输出目录不可写：{0}</sys:String>
    <sys:String x:Key="Err_ArchiveNotFound">压缩文件不存在</sys:String>
    <sys:String x:Key="Err_UnknownExtractDir">无法确定解压目录</sys:String>
    <sys:String x:Key="Err_ExtractDirNotWritable">压缩文件所在目录不可写：{0}</sys:String>
    <sys:String x:Key="Err_BuildCompressCommand">无法构建压缩命令</sys:String>
    <sys:String x:Key="Err_ArchiveNotCreated">压缩命令已结束，但未生成压缩文件：{0}</sys:String>
    <sys:String x:Key="Err_BuildExtractCommand">无法构建解压命令</sys:String>
    <sys:String x:Key="Err_PasswordRetries">连续多次密码错误，已放弃解压</sys:String>
    <sys:String x:Key="Err_InnerTarFailed">解压压缩 tar 失败：未能解开内部的 tar</sys:String>
    <sys:String x:Key="Err_ComponentMissing">未找到 7-Zip 组件</sys:String>
    <sys:String x:Key="Err_ResourceMissing">资源未找到：{0}</sys:String>
    <sys:String x:Key="Err_EmptyCommand">命令行为空</sys:String>
    <sys:String x:Key="Err_SevenZipExeMissing">未找到 7z.exe：{0}</sys:String>

    <!-- 内部日志文本 -->
    <sys:String x:Key="Log_LanguageSwitchFailed">切换语言失败（{0}）：{1}</sys:String>
    <sys:String x:Key="Log_AutoExtractEach">自动模式：逐个解压 {0} 个压缩包</sys:String>
    <sys:String x:Key="Log_TaskException">任务执行异常：{0}</sys:String>
    <sys:String x:Key="Log_ChoseMerge">用户选择合并为单个压缩包，共 {0} 个文件</sys:String>
    <sys:String x:Key="Log_ChoseSeparate">用户选择不合并，{0} 个文件分别压缩</sys:String>
    <sys:String x:Key="Log_SevenZipWarning">7-Zip 提示（有警告但已完成）：{0}</sys:String>
    <sys:String x:Key="Log_PasswordDialogFailed">弹出密码输入框失败：{0}</sys:String>
    <sys:String x:Key="Log_PasswordCancelled">用户取消了密码输入</sys:String>
    <sys:String x:Key="Log_PasswordAsked">7-Zip 索要密码，第 {0} 次尝试，弹窗请求输入</sys:String>
    <sys:String x:Key="Log_PasswordWrong">密码错误，第 {0} 次尝试，重新询问密码</sys:String>
    <sys:String x:Key="Log_PasswordGot">已获取密码</sys:String>
    <sys:String x:Key="Log_InnerTarMissing">未找到中间 tar 文件：{0}</sys:String>
    <sys:String x:Key="Log_InnerTarFailed">解开中间 tar 失败：{0}</sys:String>
    <sys:String x:Key="Log_OutputPathInvalid">输出路径不存在，已清空：{0}</sys:String>
    <sys:String x:Key="Log_TaskCancelled">任务已取消</sys:String>
</ResourceDictionary>
