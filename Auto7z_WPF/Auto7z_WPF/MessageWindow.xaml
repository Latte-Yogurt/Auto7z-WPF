<Window x:Class="Auto7z_WPF.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Auto7z_WPF"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:Auto7zViewModel}"
        Title="{DynamicResource InfoTitle}"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        AllowDrop="True"
        Width="300" Height="150"
        KeyboardNavigation.TabNavigation="Cycle">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="{Binding ElementName=PasswordTitle, Path=ActualHeight}" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder"
            Background="White"
            BorderBrush="#33000000"
            BorderThickness="2">

        <Grid x:Name="MainGrid" Grid.Column="0" Margin="8">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0">
                <TextBlock x:Name="PasswordTitle" Text="{DynamicResource InfoTitle}"
                               FontFamily="Microsoft YaHei Bold, DengXian Light" FontSize="13"
                               Style="{DynamicResource Black2BlueTextBlockStyle}" Cursor="Hand"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0">
                <Grid x:Name="MinimizeButton"
                              Background="Transparent"
                              Width="15" Height="15"
                              Cursor="Hand"
                              PreviewMouseLeftButtonDown="MinimizeButton_Click">

                    <Path Data="M0,8 L9,8" StrokeThickness="2" Style="{DynamicResource YellowGreenPathStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid Width="10"/>
                <!--Data的意思是:移动到(0,0)画线到(9,9)，再移动到(0,9)画线到(9,0)-->
                <Grid x:Name="CloseButton"
                              Background="Transparent"
                              Width="15" Height="15"
                              Cursor="Hand"
                              PreviewMouseLeftButtonDown="CloseButton_Click">

                    <Path Data="M0,0 L9,9 M0,9 L9,0" StrokeThickness="2" Style="{DynamicResource RedPathStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <StackPanel  Margin="3,5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <TextBlock x:Name="QuestionText" Text="{DynamicResource MultiFilePackQuery}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>

            <Grid VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ConfirmButton" Grid.Column="0" Content="{DynamicResource ConfirmButton}" Width="90" Height="24"
                        Background="Transparent" TabIndex="0" IsDefault="True" Click="ConfirmButton_Click"/>
                <Grid x:Name="PlaceHolderGrid" Grid.Column="1" Width="Auto" MinWidth="100"/>
                <Button x:Name="CancelButton" Grid.Column="2" Content="{DynamicResource CancelTaskButton}" Width="90" Height="24"
                        Background="Transparent" TabIndex="1" IsCancel="True" Click="CancelButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
